{
  "name": {
    "nl": "Aankomende vakantie",
    "en": "Upcoming holiday",
    "de": "Kommender Urlaub",
    "fr": "Vacances à venir"
  },
  "height": 68,
  "settings": [
    {
      "id": "regio",
      "type": "dropdown",
      "title": {
        "en": "Region",
        "nl": "Regio",
        "de": "Region",
        "fr": "Région"
      },
      "value": "zuid",
      "values": [
        {
          "id": "noord",
          "title": {
            "en": "North Region",
            "nl": "Regio Noord",
            "de": "Nordregion",
            "fr": "Région Nord"
          }
        },
        {
          "id": "midden",
          "title": {
            "en": "Central Region",
            "nl": "Regio Midden",
            "de": "Zentralregion",
            "fr": "Région Centrale"
          }
        },
        {
          "id": "zuid",
          "title": {
            "en": "South Region",
            "nl": "Regio Zuid",
            "de": "Südregion",
            "fr": "Région Sud"
          }
        }
      ],
      "hint": {
        "en": "Select a region",
        "nl": "Selecteer regio",
        "de": "Wählen Sie eine Region",
        "fr": "Sélectionnez une région"
      }
    },
    {
      "id": "only_upcoming",
      "type": "checkbox",
      "value": true,
      "title": {
        "en": "Always show the next holiday",
        "nl": "Toon altijd de eerstvolgende vakantie",
        "de": "Immer die nächsten Ferien anzeigen",
        "fr": "Toujours afficher les prochaines vacances"
      },
      "hint": {
        "en": "Ignores the holiday chosen below. The widget shows one holiday at a time.",
        "nl": "Negeert de hieronder gekozen vakantie. De widget toont één vakantie tegelijk.",
        "de": "Ignoriert die unten gewählten Ferien. Das Widget zeigt jeweils einen Urlaub an.",
        "fr": "Ignore les vacances choisies ci-dessous. Le widget affiche une seule période à la fois."
      }
    },
    {
      "id": "holiday",
      "type": "autocomplete",
      "title": {
        "en": "Holiday",
        "nl": "Vakantie",
        "de": "Urlaub",
        "fr": "Vacances"
      },
      "hint": {
        "en": "Select a holiday or leave empty for the next holiday",
        "nl": "Selecteer een vakantie of laat leeg voor de eerstvolgende vakantie",
        "de": "Wählen Sie einen Urlaub oder lassen Sie das Feld leer für den nächsten Urlaub",
        "fr": "Sélectionnez des vacances ou laissez vide pour les prochaines vacances"
      }
    }
  ],
  "api": {
    "getUpcomingHolidays": {
      "method": "POST",
      "path": "/upcoming"
    },
    "getHolidayById": {
      "method": "GET",
      "path": "/holiday/:id"
    },
    "updateSettings": {
      "method": "PUT",
      "path": "/holiday/:id"
    }
  }
}
